{
  "expo": {
    "name": "proxy-app",
    "slug": "proxy-app",
    "scheme": "proxy-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.sutharsika.proxyapp",
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.sutharsika.proxyapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-camera", { "cameraPermission": "Allow $(PRODUCT_NAME) to scan your boarding pass." }],
      ["expo-image-picker", { "photosPermission": "Allow $(PRODUCT_NAME) to access your boarding pass photo." }],
      "expo-font"
    ]
  }
}
